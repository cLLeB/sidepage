{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sidepage",
  "version": "0.10.0",
  "identifier": "io.github.clleb.sidepage",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sidepage",
        "width": 1360,
        "height": 860,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      { "ext": ["epub", "mobi", "azw", "azw3", "fb2", "djvu", "cbz", "cbr", "cb7", "cbt"], "name": "Book", "role": "Viewer" },
      { "ext": ["sidepage"], "name": "Sidepage book with notes", "role": "Editor" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
