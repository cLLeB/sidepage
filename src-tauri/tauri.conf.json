{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sidepage",
  "version": "0.31.1",
  "identifier": "io.github.clleb.sidepage",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sidepage",
        "width": 1360,
        "height": 860,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf",
          "docx",
          "doc",
          "rtf",
          "odt",
          "pptx",
          "ppt",
          "pps",
          "txt",
          "md",
          "markdown",
          "html",
          "htm"
        ],
        "name": "Sidepage.Document",
        "description": "Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "epub",
          "mobi",
          "azw",
          "azw3",
          "kf8",
          "fb2",
          "fbz",
          "cbz",
          "cbr",
          "cb7",
          "cbt",
          "djvu",
          "djv"
        ],
        "name": "Sidepage.Book",
        "description": "Book",
        "role": "Viewer"
      },
      {
        "ext": [
          "jpg",
          "jpeg",
          "png",
          "gif",
          "webp",
          "bmp",
          "svg",
          "avif"
        ],
        "name": "Sidepage.Picture",
        "description": "Picture",
        "role": "Viewer"
      },
      {
        "ext": [
          "sidepage"
        ],
        "name": "Sidepage.Bundle",
        "description": "Sidepage book with notes",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
